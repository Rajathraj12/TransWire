# Copy this file to keystore.properties (which is gitignored) and fill in your release keystore details.
# Or export TRANSWIRE_STORE_FILE, TRANSWIRE_STORE_PASSWORD, TRANSWIRE_KEY_ALIAS, TRANSWIRE_KEY_PASSWORD.
storeFile=path/to/transwire-release.jks
storePassword=CHANGE_ME
keyAlias=transwire
keyPassword=CHANGE_ME

