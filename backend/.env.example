PORT=3000
CORS_ORIGIN=*

# Option 1 (Recommended): Cloudflare Realtime TURN (1,000 GB/month free)
CLOUDFLARE_TURN_KEY_ID=your_cloudflare_turn_token_id
CLOUDFLARE_TURN_API_TOKEN=your_cloudflare_turn_api_token
# CLOUDFLARE_TURN_TTL_SECONDS=14400

# Option 2: Self-hosted Coturn HMAC credentials
# TURN_SERVER_URLS=turn:your.turn.server:3478,turns:your.turn.server:5349?transport=tcp
# TURN_SHARED_SECRET=your_super_secret_key_here

# Option 3: Static TURN credentials (used directly or as fallback if Cloudflare fails)
# TURN_SERVER_URLS=turn:relay.example.com:80,turns:relay.example.com:443?transport=tcp
# TURN_USERNAME=your_turn_username
# TURN_PASSWORD=your_turn_password
